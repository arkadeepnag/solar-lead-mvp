:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#edf4ee;background:#06100d;font-synthesis:none}*{box-sizing:border-box}body{margin:0;background:#06100d;color:#edf4ee}button,input{font:inherit}button{cursor:pointer}header{height:68px;border-bottom:1px solid #1c2a24;display:flex;align-items:center;padding:0 26px;gap:28px;background:#07100e;position:sticky;top:0;z-index:20}.brand{display:flex;gap:11px;align-items:center;min-width:210px}.logo{width:31px;height:31px;border-radius:9px;background:#c9ff3d;color:#07100e;display:grid;place-items:center;font-weight:900}.brand strong{display:block;font-size:17px}.brand small{display:block;color:#66766e;font-size:8px;letter-spacing:1.2px;margin-top:2px}.territory{display:flex;align-items:center;gap:10px;font-size:11px;color:#73837a}.territory b{background:#11231b;border:1px solid #304438;padding:7px 12px;border-radius:8px;color:#c9ff3d}.territory em{font-style:normal;color:#c9ff3d;font-weight:800}.search{margin-left:auto;width:235px;border:1px solid #26362e;border-radius:9px;padding:9px 11px;display:flex;gap:7px;color:#6d7d74}.search input{background:none;border:0;outline:0;color:#dfe9e1;width:100%;font-size:11px}.live{font-size:10px;color:#c9ff3d;font-weight:700}.live i{display:inline-block;width:7px;height:7px;background:#c9ff3d;border-radius:50%;margin-right:6px}.body{display:grid;grid-template-columns:180px 1fr;min-height:calc(100vh - 68px)}aside{border-right:1px solid #1c2a24;padding:24px 13px;background:#07110e}.navtitle{font-size:8px;color:#53655b;letter-spacing:1.5px;margin:0 9px 10px}aside>button{width:100%;border:0;background:none;color:#718179;padding:11px 10px;text-align:left;border-radius:8px;font-size:11px;margin-bottom:2px}aside>button span{display:inline-block;width:23px;color:#6d8275}aside>button.on,aside>button:hover{background:#102019;color:#f2f8f3}.sideDivider{height:1px;background:#1b2b23;margin:18px 0}.seg{display:grid;grid-template-columns:1fr 1fr;border:1px solid #26372f;border-radius:8px;padding:3px;margin-bottom:22px}.seg button{border:0;background:none;color:#718178;border-radius:6px;padding:8px 2px;font-size:9px}.seg button.on{background:#c9ff3d;color:#09110d;font-weight:800}.source{display:flex;flex-direction:column;gap:8px;color:#61736a;font-size:8px;line-height:1.35}.source b{color:#a2b0a8;font-size:8px;letter-spacing:1px}.source span:first-of-type{color:#8ea39a}main{padding:28px 28px 50px;min-width:0}.hero{display:flex;justify-content:space-between;gap:20px;margin-bottom:20px}.eyebrow{color:#8ea199;font-size:8px;letter-spacing:1.6px}.hero h1{font-size:25px;line-height:1.15;margin:7px 0 6px;letter-spacing:-.8px}.hero p{font-size:10px;color:#718178;margin:0}.actions{display:flex;gap:8px;align-items:flex-start}.actions button,.detailHead button{background:#091511;border:1px solid #2b3b33;color:#aebbb4;border-radius:8px;padding:10px 13px;font-size:10px}.actions .primary{background:#c9ff3d;color:#07100e;border-color:#c9ff3d;font-weight:800}.mapWrap{height:470px;border:1px solid #26362e;border-radius:13px;overflow:hidden;background:#050a08;position:relative}.mapTop{position:absolute;z-index:800;left:15px;right:15px;top:13px;display:flex;justify-content:space-between;pointer-events:none}.mapTop h2{font-size:13px;margin:4px 0;color:#eef5ef}.mapLegend{display:flex;gap:12px;background:rgba(5,10,8,.86);border:1px solid #28382f;border-radius:9px;padding:9px 11px;align-self:flex-start}.mapLegend span{font-size:9px;color:#aab6af}.dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:5px}.dot.hot{background:#ff8d3a}.dot.mid{background:#d7d54d}.dot.risk{background:#e85d4d}.map{position:absolute;inset:0}.leaflet-container{background:#0a100e;font:10px Inter,sans-serif}.leaflet-tile{filter:saturate(.45) brightness(.7) contrast(.92)}.leaflet-control-zoom{border:1px solid #314039!important}.leaflet-control-zoom a{background:#09130f!important;color:#c9ff3d!important;border-color:#314039!important}.mapControls{position:absolute;z-index:900;left:15px;right:15px;bottom:15px;display:flex;justify-content:space-between;align-items:end;pointer-events:none}.modeBtns{display:flex;gap:5px;pointer-events:auto}.modeBtns button{border:1px solid #314038;background:rgba(6,15,12,.92);color:#829087;padding:8px 10px;border-radius:7px;font-size:9px}.modeBtns button.active{background:#c9ff3d;color:#07100e;border-color:#c9ff3d;font-weight:800}.sun{pointer-events:auto;background:rgba(6,15,12,.94);border:1px solid #314038;border-radius:9px;padding:9px 11px;display:flex;align-items:center;gap:9px;color:#d4e0d8}.sun input{accent-color:#c9ff3d;width:155px}.sun b{font-size:10px;color:#c9ff3d}.sun small{font-size:8px;color:#77877e}.mapCaption{position:absolute;left:15px;bottom:12px;z-index:901;font-size:8px;color:#a1aea6;background:rgba(4,9,7,.7);padding:4px 7px;border-radius:5px}.contentGrid{display:grid;grid-template-columns:330px 1fr;gap:12px;margin-top:12px}.rank,.detail{border:1px solid #26362e;background:#08120f;border-radius:12px;overflow:hidden}.sectionHead{padding:14px 14px 11px;border-bottom:1px solid #203029;display:flex;justify-content:space-between;align-items:center}.sectionHead b{display:block;font-size:11px}.sectionHead span{font-size:8px;color:#65766c}.dispatchQ{color:#c9ff3d!important;letter-spacing:1px}.leadRow{width:100%;border:0;border-bottom:1px solid #1c2b24;background:none;color:#dfe8e2;display:grid;grid-template-columns:24px 1fr 55px;gap:8px;text-align:left;padding:12px 11px}.leadRow:hover,.leadRow.selected{background:#0f2018}.rankNo{font-size:9px;color:#64766c;padding-top:2px}.leadMain strong{display:block;font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.leadMain small{display:block;color:#687a70;font-size:7.5px;margin:3px 0 6px}.leadMain span{font-size:7px;color:#9baa9f;border:1px solid #27372f;border-radius:4px;padding:3px 4px;margin-right:3px}.scores label{display:flex;justify-content:space-between;font-size:6px;color:#63746b;margin-bottom:3px}.scores label b{color:#c9ff3d}.scores i{height:3px;background:#1b2a23;display:block;border-radius:3px;margin-bottom:8px}.scores i em{display:block;height:100%;background:#c9ff3d;border-radius:3px}.scores label:nth-of-type(2) b{color:#f0ae45}.scores i.credit em{background:#e9aa43}.detail{padding:16px}.detailHead{display:flex;justify-content:space-between;align-items:start;border-bottom:1px solid #203029;padding-bottom:12px}.badge{font-size:7px;color:#c9ff3d;background:#11221a;border:1px solid #30473b;padding:4px 6px;border-radius:5px}.detailHead h2{font-size:17px;margin:7px 0 3px}.detailHead p{font-size:8px;color:#6d7d74;margin:0}.dispatch{color:#07100e!important;background:#c9ff3d!important;border-color:#c9ff3d!important;font-weight:800}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:10px}.metric{border:1px solid #1f3028;border-radius:8px;padding:12px;background:#091510}.metric small,.miniGrid small{display:block;font-size:7px;color:#5f7068;letter-spacing:.6px}.metric strong{display:block;font-size:18px;margin:5px 0 2px;letter-spacing:-.5px}.metric span{font-size:7px;color:#718178}.scoregrid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:7px}.scoregrid>div{border:1px solid #1f3028;border-radius:8px;padding:12px}.scoreTitle{display:flex;justify-content:space-between;font-size:8px;color:#819087}.scoreTitle b{font-size:16px;color:#c9ff3d}.scoreTitle b.orange{color:#f0ae45}.bar{height:5px;background:#1a2922;border-radius:5px;margin:9px 0 5px}.bar i{display:block;height:100%;background:#c9ff3d;border-radius:5px}.bar.orange i{background:#f0ae45}.scoregrid small{font-size:7px;color:#5f7167}.lower{display:grid;grid-template-columns:1.2fr .8fr;gap:7px;margin-top:7px}.analysis,.offer{border:1px solid #1f3028;border-radius:8px;padding:12px;background:#091510}.cardHead{display:flex;justify-content:space-between;align-items:center}.cardHead b{font-size:10px}.cardHead span{font-size:7px;color:#718178}.spark{width:100%;height:85px;margin-top:6px}.months{display:flex;justify-content:space-between;color:#596a61;font-size:7px}.miniGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:12px}.miniGrid b{font-size:11px;display:block;margin-top:4px}.offerBig{font-size:26px;font-weight:800;color:#c9ff3d;margin:18px 0 14px}.offerBig small{display:block;font-size:8px;color:#718178;font-weight:500;margin-top:3px}.offerLines{display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:8px;color:#738279}.offerLines span{border-bottom:1px solid #1d2b24;padding-bottom:6px}.offerLines b{float:right;color:#dce6df}.offer button{width:100%;margin-top:16px;border:1px solid #c9ff3d;background:#c9ff3d;color:#07100e;border-radius:7px;padding:10px;font-size:9px;font-weight:800}.footGrid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:12px}.footGrid>div{border:1px solid #1f3028;border-radius:9px;padding:12px;background:#08120f}.footGrid b{display:block;font-size:9px;margin-bottom:8px}.footGrid span{display:block;font-size:8px;color:#6d7d74;margin:5px 0}.overlay{position:fixed;inset:0;background:rgba(0,0,0,.62);z-index:1000;display:grid;place-items:center}.wa{width:360px;background:#07100d;border:1px solid #38503f;border-radius:14px;overflow:hidden;box-shadow:0 20px 70px rgba(0,0,0,.5)}.waHead{padding:13px 15px;border-bottom:1px solid #26382f;display:flex;justify-content:space-between}.waHead b{font-size:11px}.waHead small{display:block;font-size:7px;color:#708078;margin-top:3px}.waHead button{background:none;border:0;color:#95a39b;font-size:22px}.chat{padding:15px;height:420px;overflow:auto;background:#06110d}.msg{max-width:82%;padding:9px 10px;border-radius:9px;margin:8px 0;font-size:9px;line-height:1.45;position:relative}.msg small{display:block;font-size:6px;color:#718178;margin-bottom:3px}.msg em{font-style:normal;font-size:7px;color:#c9ff3d;float:right;margin-left:7px}.msg.out{margin-left:auto;background:#163021;border:1px solid #274838}.msg.in{background:#111d18;border:1px solid #27382f}.waFoot{padding:10px;border-top:1px solid #26382f}.waFoot button{width:100%;padding:10px;border-radius:7px;border:1px solid #3c5146;background:#c9ff3d;color:#07100e;font-size:9px;font-weight:800}.waFoot button.success{background:#9ee73d}
@media(max-width:1000px){header{gap:12px}.territory{display:none}.body{grid-template-columns:140px 1fr}main{padding:18px}.contentGrid{grid-template-columns:1fr}.metrics{grid-template-columns:1fr 1fr}.lower{grid-template-columns:1fr}.footGrid{grid-template-columns:1fr}.mapWrap{height:420px}}@media(max-width:720px){header{padding:0 12px}.brand{min-width:auto}.brand small,.live{display:none}.search{width:150px}.body{display:block}aside{display:flex;overflow:auto;border-right:0;border-bottom:1px solid #1c2a24;padding:7px;gap:4px}aside .navtitle,aside .sideDivider,aside .source{display:none}aside>button{white-space:nowrap;width:auto;margin:0}.seg{min-width:150px;margin:0}.hero{display:block}.actions{margin-top:12px}.mapControls{align-items:start;flex-direction:column;gap:7px}.sun{align-self:flex-end}.metrics{grid-template-columns:1fr 1fr}}
.workbench{margin-top:12px;border:1px solid #26362e;border-radius:12px;background:#08120f;padding:14px;display:grid;grid-template-columns:1.1fr 1.6fr 1fr;gap:16px;align-items:center}.workbench>div:first-child b{display:block;font-size:10px;margin-bottom:4px}.workbench>div:first-child span,.sunCard span,.sunCard em,.route span,.learningNote{display:block;font-size:8px;color:#718178;line-height:1.5}.flow{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.flow i{font-style:normal;font-size:8px;color:#cbd6cf;border:1px solid #2b3b33;border-radius:6px;padding:6px 7px}.flow b,.learningFlow b{color:#c9ff3d}.statline{display:flex;align-items:baseline;gap:6px;flex-wrap:wrap;justify-content:flex-end}.statline b{font-size:16px;color:#c9ff3d}.statline span{font-size:7px;color:#66776e}.viabilityBars{display:flex;flex-direction:column;gap:8px}.viabilityBars>span{font-size:7px;color:#718178}.viabilityBars i{display:block;height:5px;background:#c9ff3d;border-radius:5px;margin-top:4px}.viabilityBars i.orangeBar{background:#e7a540}.sunCard{border-left:2px solid #c9ff3d;padding-left:10px}.sunCard b{font-size:9px;display:block;margin-bottom:3px}.sunCard em{font-style:normal;margin-top:4px;color:#8b9a92}.twoAxis{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.twoAxis>div{border:1px solid #213129;border-radius:8px;padding:10px}.twoAxis small{font-size:7px;color:#64756c}.twoAxis strong{display:block;font-size:16px;margin-top:5px;color:#c9ff3d}.twoAxis .orangeText{color:#e9a941}.twoAxis em{font-style:normal;font-size:7px;color:#66776d}.route{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.route>div{border:1px solid #213129;border-radius:8px;padding:10px}.route b{display:block;font-size:7px;color:#66776d}.route strong{display:block;font-size:10px;margin:5px 0}.learningFlow{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap}.learningFlow span{font-size:8px;border:1px solid #2a3a31;border-radius:6px;padding:7px;color:#cdd8d1}.learningNote{padding:9px;border-left:2px solid #c9ff3d}.leaflet-popup-content-wrapper,.leaflet-popup-tip{background:#0a1511;color:#dce7df;border:1px solid #2c4035}.leaflet-popup-content{font-size:9px}.leaflet-popup-content hr{border:0;border-top:1px solid #26372f}@media(max-width:1000px){.workbench{grid-template-columns:1fr}.statline{justify-content:flex-start}.twoAxis{grid-template-columns:1fr 1fr}.route{grid-template-columns:1fr}}
.axisCard{margin-top:12px;border:1px solid #26362e;background:#08120f;border-radius:12px;padding:14px}.axisHead{display:flex;justify-content:space-between;gap:15px;align-items:start}.axisHead b{font-size:10px;letter-spacing:.5px}.axisHead span{display:block;font-size:8px;color:#718178;margin-top:4px}.axisLegend{display:flex!important;gap:10px;align-items:center}.axisLegend span{display:flex!important;align-items:center;gap:4px;margin:0!important;white-space:nowrap}.legendDot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#c9ff3d}.legendDot.amber{background:#e9a941}.axisBody{display:grid;grid-template-columns:1fr 260px;gap:12px;margin-top:12px}.scatter{height:270px;position:relative;border:1px solid #203029;border-radius:9px;overflow:hidden;background:linear-gradient(90deg,rgba(16,29,23,.92) 0 50%,rgba(31,27,18,.35) 50% 100%)}.scatter:before{content:"";position:absolute;left:50%;top:0;bottom:0;border-left:1px dashed #405147}.scatter:after{content:"";position:absolute;left:0;right:0;bottom:50%;border-top:1px dashed #405147}.quad{position:absolute;z-index:0;padding:10px;font-size:8px;color:#5f7168}.quad b{display:block;font-size:8px;color:#8b9a92}.quad small{display:block;font-size:7px;margin-top:2px;color:#c9ff3d}.q1{left:51%;top:9%}.q2{left:2%;top:9%}.q3{left:2%;bottom:10%}.q4{left:51%;bottom:10%}.point{position:absolute;z-index:3;width:8px;height:8px;border-radius:50%;transform:translate(-50%,50%);border:1px solid #07100e;background:#6e8176;padding:0;cursor:pointer}.point.good{background:#c9ff3d}.point.risk{background:#e9a941}.point.watch{background:#8aa36e}.point.low{background:#53635b}.point.chosen{width:13px;height:13px;box-shadow:0 0 0 3px rgba(201,255,61,.18);border:2px solid #fff}.xAxis{position:absolute;bottom:5px;left:0;right:0;text-align:center;font-size:7px;color:#6d7e75;z-index:2}.yAxis{position:absolute;left:6px;top:50%;transform:rotate(-90deg) translateX(-50%);transform-origin:left top;font-size:7px;color:#6d7e75;z-index:2}.axisStats{display:grid;grid-template-columns:1fr 1fr;gap:7px}.axisStats>div{border:1px solid #203029;border-radius:8px;padding:11px;background:#091510}.axisStats small{font-size:7px;color:#65766c}.axisStats strong{display:block;font-size:21px;color:#c9ff3d;margin:4px 0}.axisStats .riskText{color:#e9a941}.axisStats span{font-size:7px;color:#718178}.selectedAxis{grid-column:1/-1;border-color:#55724f!important;background:#0d1d15!important}.bandPill{display:inline-block!important;margin-top:6px!important;border-radius:4px!important;font-size:6px!important;font-weight:800!important;letter-spacing:.3px}.bandPill.good{color:#c9ff3d!important;border-color:#4c674e!important;background:#102218}.bandPill.risk{color:#e9a941!important;border-color:#66502c!important;background:#211a0d}.bandPill.watch{color:#a7c27f!important}.bandPill.low{color:#718178!important}.mapStats{position:absolute;z-index:900;right:15px;top:76px;display:flex;gap:6px;align-items:baseline;background:rgba(5,12,9,.9);border:1px solid #2a3a31;border-radius:7px;padding:7px 9px}.mapStats b{font-size:11px;color:#c9ff3d}.mapStats span{font-size:7px;color:#708078;margin-right:6px}.leaflet-container{font-family:Inter,system-ui,sans-serif}.leaflet-popup-content-wrapper{box-shadow:0 12px 30px rgba(0,0,0,.35)}
@media(max-width:1000px){.axisBody{grid-template-columns:1fr}.axisStats{grid-template-columns:1fr 1fr}.mapStats{top:55px}.axisLegend{display:none!important}}
@media(max-width:720px){.axisStats{grid-template-columns:1fr 1fr}.scatter{height:240px}}
/* v6 MapLibre / 3D map overrides */
.mapWrap{position:relative;overflow:hidden}
.map{height:620px;min-height:620px;background:#0a1210;position:relative}
.maplibregl-map{font:inherit}
.maplibregl-ctrl-group{background:#07100d;border:1px solid #2a3a31!important;border-radius:8px!important;box-shadow:0 8px 20px rgba(0,0,0,.28)!important;overflow:hidden}
.maplibregl-ctrl button{filter:invert(1) hue-rotate(90deg);opacity:.8}
.maplibregl-ctrl-scale{background:rgba(7,16,13,.82)!important;color:#d8e3dc!important;border:1px solid #3a4d42!important;font-size:8px!important}
.mapTools{position:absolute;right:14px;bottom:88px;z-index:8;display:flex;align-items:center;gap:7px;background:rgba(5,12,9,.92);border:1px solid #2a3a31;border-radius:8px;padding:6px 7px;box-shadow:0 8px 24px rgba(0,0,0,.3)}
.mapTools button{border:1px solid #4b624f;background:#c9ff3d;color:#07100e;border-radius:6px;padding:7px 9px;font-size:8px;font-weight:800;cursor:pointer}
.mapTools span{font-size:7px;color:#718178}
.mapPopup{font-family:Inter,system-ui,sans-serif;color:#dce7df;min-width:220px}
.mapPopup .popupKicker{font-size:7px;color:#c9ff3d;letter-spacing:.9px;font-weight:800;margin-bottom:5px}
.mapPopup h3{font-size:12px;margin:0 0 4px;color:#fff}
.mapPopup p{font-size:8px;color:#91a099;margin:0 0 9px;line-height:1.45}
.mapPopup small{display:block;color:#6e8076;font-size:7px;margin-top:8px}
.popupGrid{display:grid;grid-template-columns:1fr 1fr;gap:5px 10px;border-top:1px solid #26372f;padding-top:8px}
.popupGrid b{font-size:10px;color:#c9ff3d}
.popupGrid span{font-size:6.5px;color:#718178}
.maplibregl-popup-content{background:#07100d!important;border:1px solid #2f4438!important;border-radius:10px!important;box-shadow:0 18px 50px rgba(0,0,0,.55)!important;padding:12px!important}
.maplibregl-popup-tip{border-top-color:#07100d!important;border-bottom-color:#07100d!important}
.maplibregl-popup-close-button{color:#9eaca5!important;font-size:18px!important;padding:5px 8px!important}
.maplibregl-popup-anchor-bottom .maplibregl-popup-tip{border-top-color:#07100d!important}
.mapCaption{background:linear-gradient(180deg,rgba(7,16,13,.9),rgba(7,16,13,.96));padding:9px 12px;font-size:7px;color:#708078;border-top:1px solid #24332c}
@media(max-width:1000px){.map{height:500px;min-height:500px}.mapTools{bottom:82px}.mapStats{top:70px}}
@media(max-width:720px){.map{height:430px;min-height:430px}.mapTools{right:8px;bottom:80px}.mapTools span{display:none}}
